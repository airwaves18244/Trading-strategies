# Copy to .env and fill in. NEVER commit .env.

# Finam Trade API secret token (portal -> Tokens). Used to mint 15-min JWTs.
QBT_FINAM_SECRET=

# MOEX ALGOPACK subscription token (datashop).
QBT_ALGOPACK_TOKEN=

# Where parquet cache + manifest live. Default: %LOCALAPPDATA%/qbt on Windows, ~/.cache/qbt elsewhere.
# QBT_CACHE_DIR=

# Directory for backtest run artifacts. Default: ./runs
# QBT_RUNS_DIR=
